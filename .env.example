# Set the final public origin before launch. Local preview is not indexed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Verified public phone, WhatsApp, email, address and map are in src/lib/contact.ts.
# Keep secrets server-only. Never prefix SMTP settings with NEXT_PUBLIC_.
# No email is sent unless enabled and every required setting is valid.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=info@aliyasrealestate.ae

# cPanel can use its existing mail service without storing mailbox passwords.
# Requires /sbin/sendmail on the host, plus SMTP_FROM and SMTP_TO above.
# Keep disabled on preview/test processes; takes precedence over SMTP when enabled.
SENDMAIL_ENABLED=false

# Optional absolute private persistent directory. Defaults to .data in the project.
ENQUIRY_DATA_DIR=
